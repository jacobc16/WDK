#Debug {
    width: 20%;
    background-color: rgba(0, 0, 0, 0.5);
    color: #ffffff;
    padding: 10px;
    border-radius: 10px;
    align-items: center;
    max-height: 50%;
}

#Debug #ObjectName {
    font-size: 25px;
    -unity-text-align: middle-center;
}

#Debug Label {
    margin: 0;
    padding: 0;
    font-size: 20px;
}

#Debug ScrollView {
    width: 100%;
    height: 100%;
}

#Debug .category {
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 5px;
    background-color: rgba(50, 50, 50, .8);
    border-radius: 5px;
    align-items: center;

}

#Debug .category #CategoryName {
    margin-bottom: 2px;
    margin-top: 2px;
}

#Debug .category .spacer {
    height: 2px;
    width: 100%;
    background-color: rgba(100, 100, 100, .5);
    margin-bottom: 4px;
}

#Debug .category #Content {
    width: 100%;
}

#Debug .category #Content Label {
    font-size: 16px;
}